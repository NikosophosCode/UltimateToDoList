# ===========================================
# UltimateToDo - Variables de Entorno
# ===========================================
# Copia este archivo como .env y configura tus valores

# ===========================================
# API Configuration
# ===========================================
# URL base del backend API
VITE_API_BASE_URL=http://localhost:3001/api

# ===========================================
# Authentication
# ===========================================
# Tiempo de expiración del access token (en minutos)
VITE_ACCESS_TOKEN_EXPIRY=15

# Tiempo de expiración del refresh token (en días)  
VITE_REFRESH_TOKEN_EXPIRY=7

# ===========================================
# OAuth Providers
# ===========================================
# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook OAuth
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# ===========================================
# Feature Flags
# ===========================================
# Habilitar OAuth con Google
VITE_ENABLE_GOOGLE_AUTH=true

# Habilitar OAuth con Facebook
VITE_ENABLE_FACEBOOK_AUTH=true

# Habilitar modo desarrollo (logs adicionales)
VITE_DEV_MODE=true

# ===========================================
# Upload Configuration  
# ===========================================
# Tamaño máximo de archivo en bytes (5MB)
VITE_MAX_FILE_SIZE=5242880

# Tipos de archivo permitidos para avatares
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
